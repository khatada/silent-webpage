{
  "name": "tokyo-after-hours",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "verify": "npm run typecheck && npm run lint && npm test && npm run art:check && npm run build",
    "prepare": "husky",
    "art:correct": "node --import tsx scripts/correct-pixel-art.ts",
    "art:check": "node --import tsx scripts/check-art-review.ts",
    "art:capture": "node --import tsx scripts/capture-art-review.ts",
    "art:preview-cat": "node --import tsx scripts/preview-generated-cat.ts",
    "art:preview-windows": "node --import tsx scripts/preview-generated-windows.ts",
    "art:preview-street-car": "node --import tsx scripts/preview-generated-street-car.ts",
    "art:preview-curtain": "node --import tsx scripts/preview-generated-curtain.ts",
    "art:preview-cat-turn": "node --import tsx scripts/preview-generated-cat-turn.ts",
    "art:preview-fan": "node --import tsx scripts/preview-generated-fan.ts",
    "art:preview-resident": "node --import tsx scripts/preview-generated-resident.ts",
    "art:preview-steam": "node --import tsx scripts/preview-generated-steam.ts",
    "art:preview-meteor": "node --import tsx scripts/preview-generated-meteor.ts",
    "art:preview-laundry": "node --import tsx scripts/preview-generated-laundry.ts",
    "art:preview-upper-cloud": "node --import tsx scripts/preview-generated-upper-cloud.ts",
    "art:preview-skyline-lights": "node --import tsx scripts/preview-generated-skyline-lights.ts",
    "art:preview-stars": "node --import tsx scripts/preview-generated-stars.ts",
    "art:preview-star-coverage": "node --import tsx scripts/preview-star-coverage.ts"
  },
  "dependencies": {
    "pixi.js": "^8.14.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.56.0",
    "@types/node": "^22.20.5",
    "@types/pngjs": "^6.0.5",
    "eslint": "^9.39.0",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "pngjs": "^7.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.0"
  }
}
